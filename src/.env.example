APP_NAME="Arioli.dev"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# =========================================
# SESSION CONFIGURATION (Enterprise Multitenant)
# =========================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Enterprise: Redis session configuration for tenant isolation
SESSION_CONNECTION=sessions
SESSION_STORE=sessions
SESSION_TABLE=sessions

# Enterprise: Security settings for session cookies
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
SESSION_EXPIRE_ON_CLOSE=false

# Enterprise: Session cookie naming for tenant isolation
SESSION_COOKIE=arioli-saas-session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# =========================================
# CACHE CONFIGURATION (Enterprise Multitenant)
# =========================================
CACHE_STORE=redis
CACHE_PREFIX=arioli-saas-

# Enterprise Redis Configuration for Multitenant Performance
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLUSTER=redis
REDIS_PREFIX=arioli-saas-

# Enterprise: Connection optimization
REDIS_PERSISTENT=true
REDIS_TCP_KEEPALIVE=1
REDIS_READ_TIMEOUT=60
REDIS_TCP_USER_TIMEOUT=60
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000

# Enterprise: Database isolation by purpose
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_TENANT_CACHE_DB=4

# Enterprise: Cache connections for tenant isolation
REDIS_CACHE_CONNECTION=cache
REDIS_TENANT_CONNECTION=tenant_cache
REDIS_SESSION_CONNECTION=sessions
REDIS_LICENSE_CONNECTION=cache
REDIS_STATS_CONNECTION=cache

# Enterprise: Lock connections for distributed operations
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_TENANT_LOCK_CONNECTION=default
REDIS_SESSION_LOCK_CONNECTION=default
REDIS_STATS_LOCK_CONNECTION=default
REDIS_LICENSE_LOCK_CONNECTION=default

# Enterprise: Optimizations (applied automatically by CacheServiceProvider)
# REDIS_SERIALIZER and REDIS_COMPRESSION are configured programmatically
# for compatibility across different Redis extension versions

# Memcached (fallback for development)
MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API de validación de licencias (usado por sistemas externos: Loteos, Clínicas, etc.)
API_LICENSE_SECRET=

# =========================================
# DOMINIOS Y ARQUITECTURA MULTI-TENANT
# =========================================
# Dominio base para tenants (dev: 127.0.0.1.nip.io | prod: arioli.dev)
TENANT_DOMAIN=127.0.0.1.nip.io
ADMIN_DOMAIN=admin.127.0.0.1.nip.io
CLIENTE_DOMAIN=cliente.127.0.0.1.nip.io
LANDING_DOMAIN=127.0.0.1.nip.io

# Dominio base para construcción de URLs de tenant (idéntico a TENANT_DOMAIN)
SAAS_TENANT_DOMAIN=127.0.0.1.nip.io

# Host del panel admin — usado por apps externas para validar licencias
SAAS_ADMIN_HOST=admin.127.0.0.1.nip.io

# Dominios centrales de Stancl/Tenancy (CSV — deben incluir todos los dominios del core)
# Dev:  127.0.0.1.nip.io,admin.127.0.0.1.nip.io,cliente.127.0.0.1.nip.io
# Prod: arioli.dev,admin.arioli.dev,cliente.arioli.dev
TENANCY_CENTRAL_DOMAINS=127.0.0.1.nip.io,admin.127.0.0.1.nip.io,cliente.127.0.0.1.nip.io

# HestiaCP — automatización de hosting (Fase 0a). Clave SSH dedicada,
# distinta de la usada para instalar el servidor — ver docs de la fase.
HESTIACP_SSH_HOST=host.arioli.dev
HESTIACP_SSH_PORT=22
HESTIACP_SSH_USER=ubuntu
HESTIACP_SSH_KEY_PATH=
HESTIACP_PANEL_URL=https://host.arioli.dev:8083
HESTIACP_HESTIA_USER=hestiaadmin
HESTIACP_SERVER_IP=51.222.138.208

# Porkbun — API de registro de dominios (Fase Porkbun).
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# Cotización USD/ARS de respaldo — solo se usa si dolarapi.com falla.
DOLAR_FALLBACK_RATE=1000
