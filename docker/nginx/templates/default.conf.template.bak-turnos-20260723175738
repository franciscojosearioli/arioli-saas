        include        fastcgi_params;
        fastcgi_param  HTTP_X_TENANT $tenant_subdomain;
    }

    location ~ /\.(?!well-known).* { deny all; }

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript text/xml;
}
