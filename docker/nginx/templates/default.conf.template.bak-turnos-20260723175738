map $host $tenant_subdomain {
    ~^(?<sub>[^.]+)\.arioli\.dev$             $sub;
    default                                    "";
}

ssl_protocols TLSv1.2 TLSv1.3;
ssl_ciphers HIGH:!aNULL:!MD5;
ssl_prefer_server_ciphers on;
# Docker embedded DNS — re-resuelve nombres de contenedor en runtime (evita IPs cacheadas tras un restart individual)
resolver 127.0.0.11 valid=10s;

# Landing pública
server {
    listen 80;
    listen 443 ssl;
    server_name arioli.dev;
    root /var/www/html/public;
    index index.php;

    ssl_certificate     /etc/nginx/ssl/cloudflare-origin.pem;
    ssl_certificate_key /etc/nginx/ssl/cloudflare-origin.key;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    client_max_body_size 50M;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    location ~ \.php$ {
        set $upstream_app app;
        fastcgi_pass   $upstream_app:9000;
        fastcgi_index  index.php;
        fastcgi_param  SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include        fastcgi_params;
    }

    location ~ /\.(?!well-known).* { deny all; }
}

