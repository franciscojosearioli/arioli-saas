# Subastas — instancias de tenant (ver propuesta_subastas_judiciales.pdf) — DNS-only, cert Let's Encrypt
server {
    listen 80;
    listen 443 ssl;
    server_name *.subastas.arioli.dev subastas.internal;
    root /var/www/subastas/public;
    index index.php;

    ssl_certificate     /etc/letsencrypt/live/loteos.arioli.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/loteos.arioli.dev/privkey.pem;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    client_max_body_size 50M;

    location /storage/ {
        alias /var/www/subastas/storage/app/public/;
        try_files $uri $uri/ =404;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # WebSockets — Laravel Reverb (Módulo 3, pujas en tiempo real)
    location /app/ {
        proxy_pass http://subastas_reverb:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    location ~ \.php$ {
        fastcgi_pass   subastas_app:9000;
        fastcgi_index  index.php;
        fastcgi_param  SCRIPT_FILENAME /var/www/html/public$fastcgi_script_name;
        include        fastcgi_params;
    }

    location ~ /\.(?!well-known).* { deny all; }
}

